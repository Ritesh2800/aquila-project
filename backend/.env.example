# Aquila Backend Environment Variables

# Server & Security
AQUILA_API_KEY=
AQUILA_MAX_UPLOAD_MB=500
AQUILA_CORS=http://localhost:5173

# Camera / Demo
AQUILA_CAMERA="CAM-01 (demo)"
AQUILA_OBJ_WEIGHTS=yolov8m.pt
AQUILA_POSE_WEIGHTS=yolov8m-pose.pt

# Twilio Voice / SMS Alerts
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_TO=

# Telegram Alerts (Optional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
